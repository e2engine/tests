{
  "kind": "Environment",
  "version": "1.0.0",
  "name": "direct-real-http",
  "description": "one real HTTP service that returns 200 OK for /healthz",
  "spec": {
    "services": [
      {
        "id": "direct-real-http",
        "kind": "http",
        "mode": "real",
        "address": "127.0.0.1:8083",
        "http_target": "http://127.0.0.1:9000"
      }
    ]
  }
}
